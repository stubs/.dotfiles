#!/usr/bin/env bash

# Create a new directory and enter it
function mkd() {
    mkdir -p "$@" && cd "$@"
}

# Open man page as PDF
function manpdf() {
    man -t "${1}" | open -f -a /Applications/Preview.app/
}

if [[ $USER = 'agonzalez' ]]; then
    function scpt() {
        scp "${1}" taskmaster1:/home/dpuser/agonzalez/
    }
    function scpt2() {
        scp "${1}" taskmaster2:/home/agonzalez/
    }
fi

parse_git_branch() {
  git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ [\1]/'
}

quick_tox() {
    # Quick checkout of dev branch, and validate with tox for checking team members' PRs.

    # accept user cli arg of branch to checkout, save current branch to return to when done
    branch="${1}"
    prev_branch="$(git rev-parse --abbrev-ref HEAD)"

    # stash changes before checkout?
    if [[ -z $(git status -s) ]]; then
        git checkout "$branch"
        git pull

        # run tox on new branch
        if [[ -f "$(git rev-parse --show-toplevel)/tox.ini" ]]; then
            tox
        fi

        # checkout previous branch
        git checkout "$prev_branch"
        unset branch
        unset prev_branch
    else
        echo "You have uncommitted changes.  Please stash or commit before quick_tox run."
        return 1
    fi
}

# ripgrep->fzf->neovim [QUERY]
rfv() (
  RELOAD='reload:rg -. --column --color=always --smart-case --glob '!**/.git/' {q} || :'
  OPENER='if [[ $FZF_SELECT_COUNT -eq 0 ]]; then
            $EDITOR {1} +{2}     # No selection. Open the current line in NeoVim.
          else
            $EDITOR +cw -q {+f}  # Build quickfix list for the selected items.
          fi'
  fzf --disabled --ansi --multi \
      --bind "start:$RELOAD" --bind "change:$RELOAD" \
      --bind "enter:become:$OPENER" \
      --bind "ctrl-o:execute:$OPENER" \
      --bind 'alt-a:select-all,alt-d:deselect-all,ctrl-/:toggle-preview' \
      --delimiter : \
      --preview 'bat --style=full --color=always --highlight-line {2} {1}' \
      --preview-window '~4,+{2}+4/3,<80(up)' \
      --query "$*"
)

# herdr worktree from an existing remote branch: hwc feature/some-branch
hwc() {
    if ! command -v herdr &> /dev/null; then
        echo "hwc: herdr not installed" >&2
        return 1
    fi
    if [[ -z "$1" ]]; then
        echo "usage: hwc <remote-branch-name>" >&2
        return 1
    fi
    local repo_root
    repo_root="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")" || return 1
    git fetch origin "$1" --quiet || return 1
    herdr worktree create --cwd "$repo_root" --branch "$1" --base "origin/$1" \
        --path "$repo_root/.worktrees/$1" --focus
}

# herdr worktree picker — fzf-select an existing worktree and open it: hwl
hwl() {
    if ! command -v herdr &> /dev/null; then
        echo "hwl: herdr not installed" >&2
        return 1
    fi
    for dep in fzf jq; do
        if ! command -v "$dep" &> /dev/null; then
            echo "hwl: $dep is required. Brew install it." >&2
            return 1
        fi
    done

    local listing repo_root sel
    listing=$(herdr worktree list --cwd "$PWD") || return 1
    repo_root=$(jq -r '.result.source.repo_root' <<< "$listing")
    [ -n "$repo_root" ] && [ "$repo_root" != "null" ] || {
        echo "hwl: could not resolve repo root" >&2
        return 1
    }

    sel=$(jq -r '.result.worktrees[]
            | [(if .open_workspace_id then "●" else "○" end), .branch, .path]
            | @tsv' <<< "$listing" \
        | column -t -s $'\t' \
        | fzf --no-multi --highlight-line --header '● open   ○ closed')
    [ -n "$sel" ] || return 0

    herdr worktree open --cwd "$repo_root" --path "$(awk '{print $NF}' <<< "$sel")" --focus
}
